{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AWC",
  "version": "1.0.6",
  "identifier": "com.sjbtechnologies.awc",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AWC",
        "decorations": true,
        "height": 720,
        "width": 1280
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows":{
      "nsis":{
          "installMode": "both",
          "installerIcon": "./icons/icon.ico"
        }
    },
    
    "publisher": "SJBTechnologies Pvt. Ltd.",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "softcam.dll",
      "softcam.lib",
      "adb/*",
      "avcodec-62.dll",
      "avdevice-62.dll",
      "avfilter-11.dll",
      "avformat-62.dll",
      "avutil-60.dll",
      "swresample-6.dll",
      "swscale-9.dll"
    ],
    "license": "GPL-3.0",
    "licenseFile": "../../../LICENSE"   
  }
}