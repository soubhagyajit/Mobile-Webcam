{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AWC",
  "version": "1.0.5",
  "identifier": "com.sjbtechnologies.awc",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AWC",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows":{
      "nsis":{
          "installMode": "both"
        }
    },
    "publisher": "SJBTechnologies Pvt. Ltd.",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "softcam.dll",
      "opencv_videoio_ffmpeg4120_64.dll",
      "opencv_world4120.dll"
    ],
    "externalBin":[
      "sender"
    ]    
  }
}