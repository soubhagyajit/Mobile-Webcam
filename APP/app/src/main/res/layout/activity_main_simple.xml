<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full Screen Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Grid Lines -->
    <FrameLayout
        android:id="@+id/gridLines"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:weightSum="3">
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#60FFFFFF"/>
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#60FFFFFF"/>
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:weightSum="3">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#60FFFFFF"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#60FFFFFF"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Focus Ring Indicator -->
    <ImageView
        android:id="@+id/focusRing"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/focus_ring"
        android:visibility="invisible" />

    <!-- Exposure Vertical Slider -->
    <FrameLayout
        android:id="@+id/exposureContainer"
        android:layout_width="48dp"
        android:layout_height="240dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:background="#80000000"
        android:visibility="gone">
        <SeekBar
            android:id="@+id/exposureSeekBar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:rotation="270" />
    </FrameLayout>

    <!-- Focus Slider Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="120dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:orientation="vertical">

        <!-- Focus Slider -->
        <LinearLayout
            android:id="@+id/focusContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#80000000"
            android:padding="8dp"
            android:visibility="gone">
            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="FOC"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/focusSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Minimal Top Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/gradient_top">

        <View
            android:id="@+id/statusIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/status_dot"
            android:backgroundTint="#808080" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="READY"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/expButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="EXP"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/flashButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="FLASH"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/focusToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="FOC: A"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/ipAddressText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Detecting..."
            android:textColor="#FFFFFF"
            android:alpha="0.8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="32dp">

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_settings_24"
            android:contentDescription="Settings"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/gridButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toEndOf="@id/settingsButton"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="▦"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <FrameLayout
            android:id="@+id/shutterButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_centerInParent="true"
            android:background="@drawable/record_button_bg"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/shutterInner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/record_button_inner" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/flipButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Flip Camera"
            app:tint="#FFFFFF" />

    </RelativeLayout>

    <!-- Settings Overlay Page -->
    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#60000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#E6000000"
            android:orientation="vertical"
            android:padding="32dp"
            android:clickable="true"
            android:focusable="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/closeSettingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#FFFFFF" />
            </RelativeLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video Resolution"
                        android:textColor="#80FFFFFF"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/resolutionSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:theme="@style/ThemeOverlay.AppCompat.Dark" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="Screen Dim Timeout"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />
                        <Spinner
                            android:id="@+id/dimTimeoutSpinner"
                            android:layout_width="150dp"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/spinner_background"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:theme="@style/ThemeOverlay.AppCompat.Dark" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="Save Exposure"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />
                        <Switch
                            android:id="@+id/saveExposureSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:theme="@style/ThemeOverlay.AppCompat.Dark" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">
                        <TextView
                            android:id="@+id/qualityLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stream Quality (70%)"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />
                        <SeekBar
                            android:id="@+id/qualitySeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/qualityLabel"
                            android:layout_marginTop="12dp"
                            android:max="90" />
                    </RelativeLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Changes will apply next time the camera starts."
                        android:textColor="#60FFFFFF"
                        android:textSize="12sp" />

                    <!-- Legacy Buttons for logic mapping -->
                    <Button android:id="@+id/startButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Center idle overlay removed as requested -->
    <View android:id="@+id/idleOverlay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- Screen Dim Overlay -->
    <FrameLayout
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Solid Black Background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000" />

        <!-- Hint Text (Faded in on touch) -->
        <TextView
            android:id="@+id/dimHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="SWIPE TO WAKE"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:alpha="0" />
    </FrameLayout>

</FrameLayout>