{
  "name": "awc-desktop-client",
  "version": "1.0.4",
  "license": "GPL-3.0-or-later",
  "description": "Android Webcam Software - Desktop client",
  "author": {
    "name": "Soubhagyajit Borah",
    "email": "me@soubhagyajit.com",
    "url": "https://www.soubhagyajit.com"
  },
  "main": "main.js",
  "build": {
    "appId": "com.sjbtechnologies.awc",
    "productName": "AWC",
    "copyright": "Copyright © 2026 Soubhagyajit Borah",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "publisherName": "Soubhagyajit Borah"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "resources/sender.exe",
        "to": "sender.exe"
      },
      {
        "from": "resources/softcam.dll",
        "to": "softcam.dll"
      },
      {
        "from": "resources/opencv_world4120.dll",
        "to": "opencv_world4120.dll"
      },
      {
        "from": "resources/opencv_videoio_ffmpeg4120_64.dll",
        "to": "opencv_videoio_ffmpeg4120_64.dll"
      }
    ],
    "files": [
      "main.js",
      "autoinstaller.js",
      "virtualCamera.js",
      "index.html",
      "installer.html",
      "feed.html",
      "LOGO.png",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}